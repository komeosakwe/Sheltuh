# Copy to .env.local for local development, and set the same values in
# Vercel (Project → Settings → Environment Variables). See
# docs/supabase-setup.md for where each one comes from.
#
# Leave the Supabase values unset to run in demo mode on local sample data.

# --- Public (shipped to the browser; safe to expose) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# This app's own public origin, used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Supabase → Connect → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Only for scripts/promote-admin.ts, run from your own machine. Not needed by
# the app itself, so don't add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
