# Copy to .env.local for local development, and set the same values in
# Vercel (Project → Settings → Environment Variables). See
# docs/supabase-setup.md for where each one comes from.
#
# Leave the Supabase values unset to run in demo mode on local sample data.

# --- Public (shipped to the browser; safe to expose) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# This app's own public origin, used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kill switch for the offline/installable-app service worker (docs/pwa.md).
# Set to 1 and redeploy to make visitors' browsers remove it. Empty = on.
NEXT_PUBLIC_DISABLE_SERVICE_WORKER=
# Optional Mapbox preview on /map (docs/mapbox-preview.md). Empty = no change:
# Esri tiles and no style switch. Only ever a PUBLIC token (pk.…) with URL
# restrictions for the domains that use it, never a secret sk.… token: it is
# shipped to every visitor's browser. Add it to Vercel's Preview environment
# first, and redeploy after changing it (it's baked in at build time).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional "username/styleid" of a custom style made in Mapbox Studio; adds a
# "Sheltüh custom" choice to the preview. Ignored without the token above.
NEXT_PUBLIC_MAPBOX_STYLE=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Supabase → Connect → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Ticket emails. Without these, orders still work but no email is sent.
# Google Workspace: smtp.gmail.com, 587, the mailbox address, and an app
# password (myaccount.google.com → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@sheltuh.com.au
SMTP_PASS=
EMAIL_FROM="Sheltüh <support@sheltuh.com.au>"

# Shared secret Vercel Cron sends to /api/cron/email-outbox and
# /api/cron/trending (vercel.json) as "Authorization: Bearer <CRON_SECRET>".
# A long random string, e.g. `openssl rand -hex 32`. Unset = the cron routes
# refuse every request, so failed ticket emails are never retried and the
# trending list is never refreshed.
CRON_SECRET=

# Only for scripts/promote-admin.ts, run from your own machine. Not needed by
# the app itself, so don't add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
