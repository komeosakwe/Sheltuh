# Copy to .env.local for local development, and set the same values in
# Vercel (Project → Settings → Environment Variables). See
# docs/supabase-setup.md for where each one comes from.
#
# Leave the Supabase values unset to run in demo mode on local sample data.

# --- Public (shipped to the browser; safe to expose) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# This app's own public origin, used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kill switch for the offline/installable-app service worker (docs/pwa.md).
# Set to 1 and redeploy to make visitors' browsers remove it. Empty = on.
NEXT_PUBLIC_DISABLE_SERVICE_WORKER=
# Optional Mapbox preview on /map (docs/mapbox-preview.md). Empty = no change:
# Esri tiles and no style switch. Only ever a PUBLIC token (pk.…) with URL
# restrictions for the domains that use it, never a secret sk.… token: it is
# shipped to every visitor's browser. Add it to Vercel's Preview environment
# first, and redeploy after changing it (it's baked in at build time).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional "username/styleid" of a custom style made in Mapbox Studio; adds a
# "Sheltüh custom" choice to the preview. Ignored without the token above.
NEXT_PUBLIC_MAPBOX_STYLE=
# Event clips (short silent videos on events; docs/design/event-clips.md).
# 1 = organisers and admins can add a clip in the event editor, and the admin
# queue shows each event's clip for review. Empty (the default) or anything
# but 1 = no uploads: the editor hides the field AND the server refuses new
# uploads (503 for upload URLs and for attaching an upload). Turn it on only
# once SUPABASE_CLIP_STORAGE_KEY below is set. Clips already added still play,
# and their descriptions can still be changed or the clips removed, either
# way. Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_EVENT_CLIPS=
# Sign in with Google and/or Apple (Supabase Auth OAuth; lib/auth/oauth.ts).
# Comma separated: google, apple, or google,apple. Empty (the default) = no
# provider buttons, email and password only. List ONLY providers enabled and
# configured in the Supabase project (Authentication -> Sign In / Providers):
# a listed provider that isn't enabled sends people to a raw Supabase error
# page. In Vercel, set it for Production only: previews share the production
# Supabase project, whose Site URL is the production origin. Has no effect in
# demo mode. Baked in at build time: redeploy after changing it. Each listed
# provider needs its official logo files in public/auth/ (docs/auth-logos.md),
# or `next build` (and `next typegen`) fails naming the missing ones
# (next.config.ts).
NEXT_PUBLIC_AUTH_PROVIDERS=
# Stripe publishable key for the payment page (/checkout/pay), which mounts
# Stripe's embedded checkout form. Must be the same Stripe account and mode as
# STRIPE_SECRET_KEY (pk_test_ with sk_test_, pk_live_ with sk_live_), or paid
# checkouts are refused (503). Baked in at build time: redeploy after changing it.
# Set to anything but pk_test_… or pk_live_… (a secret sk_ key above all), the
# build fails (next.config.ts), so it can never ship in the browser bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Supabase → Connect → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Only for `npm run payment-domains` (scripts/register-payment-domains.ts), run
# by hand: a Stripe restricted key (rk_test_… / rk_live_…) allowed only payment
# method domains, deleted after use. Unset = the script uses STRIPE_SECRET_KEY.
# Never add it to Vercel. See docs/supabase-setup.md §2, step 5.
# STRIPE_DOMAINS_KEY=rk_test_...

# Ticket emails. Without these, orders still work but no email is sent.
# Google Workspace: smtp.gmail.com, 587, the mailbox address, and an app
# password (myaccount.google.com → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@sheltuh.com.au
SMTP_PASS=
EMAIL_FROM="Sheltüh <support@sheltuh.com.au>"

# Optional, server-only: where the admins' "event / organiser to review"
# emails go, as a comma-separated list of plain addresses (at most 20).
# Unset = every admin account's confirmed email address. With neither, those
# emails are skipped (logged once). Needs the SMTP settings above.
# Use an inbox only admins read (never a customer-facing one like bookings@ or
# support@): the emails name events and applicants waiting for review. When an
# admin leaves, remove their address here as well as their admin role.
# ADMIN_NOTIFY_EMAILS=admin-review-inbox@example.com

# Shared secret Vercel Cron sends to /api/cron/email-outbox and
# /api/cron/trending (vercel.json) as "Authorization: Bearer <CRON_SECRET>".
# A long random string, e.g. `openssl rand -hex 32`. Unset = the cron routes
# refuse every request, so failed ticket emails are never retried and the
# trending list is never refreshed.
CRON_SECRET=

# Event clips (short videos on events) only: a dedicated Supabase secret key
# (Supabase -> Project Settings -> API Keys -> "Create new secret key", named
# e.g. "event-clips"), read only by lib/server/clip-storage.ts to reach the
# private `event-clips` Storage bucket. Not SUPABASE_SECRET_KEY below: this
# one is separately revocable. Server-only, never NEXT_PUBLIC_. Unset = the
# clip routes answer 503 and everything else works as before.
# WARNING: Supabase secret keys can't be scoped. This is a FULL secret key with
# service-role powers over the whole project: the Data API without RLS (every
# table), Supabase Auth admin (including setting app_metadata.role = "admin"
# on any account), and every Storage bucket. The app only uses it for the
# event-clips bucket, but a leak is a whole-project compromise: revoke it at
# once. In Vercel, set it for Production only, unless Preview deployments use
# a separate Supabase project (then give Preview that project's own key).
SUPABASE_CLIP_STORAGE_KEY=

# Account invites only: a dedicated Supabase secret key (Supabase -> Project
# Settings -> API Keys -> "Create new secret key", named e.g.
# "account-invites"), read only by lib/server/auth-admin.ts to ask Supabase
# Auth for an invitee's sign-up token when they press "Create account" on
# /invite. Server-only, never NEXT_PUBLIC_. Unset = creating and resending
# invites answer 503, and invitees sign up the ordinary way.
# WARNING: like SUPABASE_CLIP_STORAGE_KEY above, this is a FULL secret key with
# service-role powers over the whole project (the Data API without RLS,
# Supabase Auth admin including making any account an admin, every Storage
# bucket). A leak is a whole-project compromise: revoke it at once. In Vercel,
# set it for Production only. Don't use the Supabase dashboard's "Invite user"
# button: its link doesn't land in this app (invite from /admin/invites).
SUPABASE_ADMIN_INVITE_KEY=

# Wallet passes (optional; docs/wallet-setup.md, docs/architecture.md "Wallet
# passes"). Each wallet switches itself on once ALL of its variables are set
# and valid, after a redeploy; with any missing or invalid it stays off (no
# button on the ticket page, its route answers 404) and the server logs which
# variable is wrong, never a value. Server-only: never NEXT_PUBLIC_. In
# Vercel, set them for Production only.
#
# Google Wallet ("Add to Google Wallet"): from the Google Pay & Wallet Console
# (Issuer ID) and the service account's JSON key file (client_email and
# private_key). Paste private_key exactly as it is in the file, \n escapes
# included (with or without its surrounding quotes).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
#
# Apple Wallet ("Add to Apple Wallet"): needs the Apple Developer Program.
# The Pass Type ID (pass.…) and Team ID, the Pass Type ID certificate and its
# private key, and Apple's WWDR G4 intermediate certificate, each PEM
# base64-encoded onto one line (`base64 -w0 file.pem`; macOS `base64 -i
# file.pem`). The passphrase only if the key PEM is encrypted.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=

# Only for scripts/promote-admin.ts, run from your own machine. Not needed by
# the app itself, so don't add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
