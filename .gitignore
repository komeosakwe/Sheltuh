# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Apple keys (Sign in with Apple, AuthKey_<KeyID>.p8): keep them in a password manager, never here
*.p8

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
supabase/.temp/


# Local load-testing harness output and state (docs/loadtest.md)
/loadtest/results/
/loadtest/.state/

# Local ticket-email previews (scripts/preview-ticket-email.ts)
/email-previews/

# Phone app (Capacitor; docs/mobile-app.md). android/ and ios/ also carry their own
# .gitignore from Capacitor's templates; these are belt and braces at the root.
# Signing material and store credentials: never committed (keep them in a password manager).
*.jks
*.keystore
*.p12
*.mobileprovision
*.provisionprofile
keystore.properties
key.properties
# Google Play / Google Cloud service-account keys (Play Console API, fastlane supply…)
*service-account*.json
*service_account*.json
play-*.json
google-services.json
GoogleService-Info.plist
# Machine-specific SDK paths
/android/local.properties
# Build outputs
/android/build/
/android/app/build/
/android/.gradle/
/android/.idea/
/android/captures/
*.apk
*.aab
/ios/App/build/
/ios/DerivedData/
*.ipa
*.xcarchive
*.dSYM.zip
# Copied in by `npx cap sync` from capacitor.config.ts and mobile/www (regenerated each sync,
# and the config copy names whichever server URL the last sync used)
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
